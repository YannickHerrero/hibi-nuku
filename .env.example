# Hibi Nuku environment — copy to `.env` for dev (loaded via dotenvy).
# In prod use systemd EnvironmentFile (see docs/deploy.md).

# Server
NUKU_PORT=8787
NUKU_HOST=0.0.0.0
NUKU_DB_PATH=backend/data/dev.db
NUKU_LIBRARY_DIR=/srv/hibi-nuku/library
NUKU_LOG=hibi_nuku=info,tower_http=info

# Static bearer token gating /api/* (defense-in-depth behind Tailscale).
# Generate one: `openssl rand -hex 32`  or  `head -c 32 /dev/urandom | base64`
NUKU_TOKEN=REPLACE_ME_WITH_A_LONG_RANDOM_STRING

# External APIs
HIBI_API_BASE=https://hibi-api.vercel.app
HIBI_API_KEY=hibi_REPLACE_ME

OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME
NUKU_LLM_MODEL=anthropic/claude-sonnet-4.5

WANIKANI_API_KEY=REPLACE_ME
